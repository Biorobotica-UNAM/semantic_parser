<launch>
  <arg name="qwen_url" default=""/>
  <arg name="qwen_api_key" default=""/>
  <arg name="qwen_timeout_sec" default="15.0"/>
  <arg name="qwen_response_format" default="goals"/>
  <arg name="use_entity_extractor" default="false"/>

  <group>
    <push_ros_namespace namespace="semantic_parser" />

    <node
      pkg="semantic_parser"
      exec="qwen_semantic_node"
      name="qwen_semantic_node"
      output="screen"
    >
      <param name="service_name" value="semantic_parser"/>
      <param name="qwen_url" value="$(var qwen_url)"/>
      <param name="qwen_api_key" value="$(var qwen_api_key)"/>
      <param name="timeout_sec" value="$(var qwen_timeout_sec)"/>
      <param name="response_format" value="$(var qwen_response_format)"/>
    </node>

    <node
      pkg="semantic_parser"
      exec="semantic_node"
      name="semantic_node"
      output="screen"
    >
    </node>

    <node
      pkg="semantic_parser"
      exec="entity_extractor_node"
      name="entity_extractor_node"
      output="screen"
    >
    </node>

    <node
      pkg="semantic_parser"
      exec="entity_extractor_node"
      name="entity_extractor_node"
      output="screen"
      if="$(var use_entity_extractor)"
    >
    </node>
  </group>
</launch>
