<launch>
  <arg name="qwen_url" default=""/>
  <arg name="qwen_api_key" default=""/>
  <arg name="qwen_timeout_sec" default="15.0"/>
  <!-- El servicio de interpretación tiene un único proveedor: Qwen. -->
  <arg name="qwen_response_format" default="goals"/>
  <arg name="use_entity_extractor" default="true"/>
  <arg name="gpsr_listen_service_name" default="listen_gpsr"/>
  <arg name="gpsr_listener_service" default="/hri/listener/listen"/>
  <arg name="gpsr_listener_grammar" default=""/>
  <arg name="gpsr_listen_timeout_sec" default="30.0"/>

  <group>
    <push_ros_namespace namespace="semantic_parser" />

    <node
      pkg="semantic_parser"
      exec="qwen_semantic_node"
      name="qwen_semantic_node"
      output="screen"
    >
      <param name="service_name" value="semantic_parser"/>
      <param name="qwen_url" value="$(var qwen_url)"/>
      <param name="qwen_api_key" value="$(var qwen_api_key)"/>
      <param name="timeout_sec" value="$(var qwen_timeout_sec)"/>
      <param name="response_format" value="$(var qwen_response_format)"/>
      <param name="gpsr_listen_service_name" value="$(var gpsr_listen_service_name)"/>
      <param name="listener_service" value="$(var gpsr_listener_service)"/>
      <param name="gpsr_listener_grammar" value="$(var gpsr_listener_grammar)"/>
      <param name="gpsr_listen_timeout_sec" value="$(var gpsr_listen_timeout_sec)"/>
    </node>

    <node
      pkg="semantic_parser"
      exec="entity_extractor_node"
      name="entity_extractor_node"
      if="$(var use_entity_extractor)"
      output="screen"
    >
    </node>

  </group>
</launch>
