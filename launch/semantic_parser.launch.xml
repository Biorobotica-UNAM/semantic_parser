<launch>
  <arg name="use_semantic_compare" default="false"/>
  <arg name="semantic_return_backend" default="best"/>
  <arg name="qwen_url" default="http://127.0.0.1:8008"/>
  <arg name="qwen_api_key" default=""/>
  <arg name="qwen_timeout_sec" default="15.0"/>

  <group>
    <push_ros_namespace namespace="semantic_parser" />

    <node
      unless="$(var use_semantic_compare)"
      pkg="semantic_parser"
      exec="semantic_node"
      name="semantic_node"
      output="screen"
    >
    </node>

    <node
      if="$(var use_semantic_compare)"
      pkg="semantic_parser"
      exec="semantic_node"
      name="semantic_node_spacy"
      output="screen"
    >
      <param name="service_name" value="semantic_parser_spacy"/>
    </node>

    <node
      if="$(var use_semantic_compare)"
      pkg="semantic_parser"
      exec="qwen_semantic_node"
      name="qwen_semantic_node"
      output="screen"
    >
      <param name="service_name" value="semantic_parser_qwen"/>
      <param name="qwen_url" value="$(var qwen_url)"/>
      <param name="qwen_api_key" value="$(var qwen_api_key)"/>
      <param name="timeout_sec" value="$(var qwen_timeout_sec)"/>
    </node>

    <node
      if="$(var use_semantic_compare)"
      pkg="semantic_parser"
      exec="semantic_compare_node"
      name="semantic_compare_node"
      output="screen"
    >
      <param name="service_name" value="semantic_parser"/>
      <param name="spacy_service" value="semantic_parser_spacy"/>
      <param name="qwen_service" value="semantic_parser_qwen"/>
      <param name="return_backend" value="$(var semantic_return_backend)"/>
      <param name="timeout_sec" value="$(var qwen_timeout_sec)"/>
    </node>

    <node
      pkg="semantic_parser"
      exec="entity_extractor_node"
      name="entity_extractor_node"
      output="screen"
    >
    </node>
  </group>
</launch>
